#!/bin/sh
set -eu

PKG="DesktopCommander-SPK"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SCRIPT_DIR/pkgvar"
VAR="$(dc_pkgvar)"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
CONFIG="$VAR/home/.claude-server-commander/config.json"

fail() {
    rc=$?
    if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        printf 'Desktop Commander 升级初始化失败（退出码 %s），数据目录：%s\n' "$rc" "$VAR" > "$SYNOPKG_TEMP_LOGFILE"
    fi
    exit "$rc"
}
trap fail EXIT HUP INT TERM

id "$PKG" >/dev/null 2>&1 || { echo "套件服务账户不存在：$PKG" >&2; exit 1; }
mkdir -p "$VAR/home/.claude-server-commander" "$VAR/home/.desktop-commander-device" "$VAR/log" "$VAR/workspace"
chown "$PKG:http" "$VAR"
chmod 2710 "$VAR"
chown "$PKG:$PKG" "$VAR/home" "$VAR/home/.claude-server-commander" "$VAR/home/.desktop-commander-device" "$VAR/log" "$VAR/workspace"
chmod 700 "$VAR/home" "$VAR/home/.claude-server-commander" "$VAR/home/.desktop-commander-device" "$VAR/log" "$VAR/workspace"
printf '%s\n' "$VAR/auth-state.json" > "$PKGDEST/ui/auth-state.path"
chmod 644 "$PKGDEST/ui/auth-state.path"
if [ -e "$VAR/auth-state.json" ]; then
    chown "$PKG:http" "$VAR/auth-state.json"
    chmod 640 "$VAR/auth-state.json"
fi
# An empty allowedDirectories list means unrestricted paths in upstream.
# Preserve other user settings while explicitly removing the package path allowlist.
"$PKGDEST/runtime/node" - "$CONFIG" <<'NODE'
const fs = require('fs');
const file = process.argv[2];
let config = {};
try { config = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (_) {}
config.allowedDirectories = [];
config.telemetryEnabled = false;
const tmp = `${file}.tmp`;
fs.writeFileSync(tmp, JSON.stringify(config, null, 2) + '\n', { mode: 0o600 });
fs.renameSync(tmp, file);
NODE
chown "$PKG:$PKG" "$CONFIG"
chmod 600 "$CONFIG"
# Device authorization, other config fields, logs, and workspace are preserved.
trap - EXIT HUP INT TERM
