#!/bin/sh
set -eu
VAR="${SYNOPKG_PKGVAR:-/var/packages/DesktopCommander-SPK/var}"
mkdir -p "$VAR/home/.claude-server-commander" "$VAR/home/.desktop-commander-device" "$VAR/log" "$VAR/workspace"
chmod 700 "$VAR/home" "$VAR/home/.claude-server-commander" "$VAR/home/.desktop-commander-device" "$VAR/log" "$VAR/workspace"
# Never replace an existing config, device.json, log, or workspace.

