#!/bin/sh
set -eu

PKG="DesktopCommander-SPK"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SCRIPT_DIR/pkgvar"
PKGVAR="$(dc_pkgvar)"
NODE="$PKGDEST/runtime/node"
APP="$PKGDEST/upstream/dist/index.js"
HOME_DIR="$PKGVAR/home"
LOG_DIR="$PKGVAR/log"
PID_FILE="$PKGVAR/remote.pid"
LOG_FILE="$LOG_DIR/remote.log"

is_running() {
    [ -s "$PID_FILE" ] || return 1
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start() {
    if is_running; then
        exit 0
    fi
    mkdir -p "$HOME_DIR/.claude-server-commander" "$HOME_DIR/.desktop-commander-device" "$LOG_DIR" "$PKGVAR/workspace"
    chmod 700 "$HOME_DIR" "$HOME_DIR/.claude-server-commander" "$HOME_DIR/.desktop-commander-device" "$LOG_DIR" "$PKGVAR/workspace"
    if [ ! -s "$HOME_DIR/.claude-server-commander/config.json" ]; then
        printf '%s\n' "{\"allowedDirectories\":[\"$PKGVAR/workspace\"],\"telemetryEnabled\":false}" > "$HOME_DIR/.claude-server-commander/config.json"
        chmod 600 "$HOME_DIR/.claude-server-commander/config.json"
    fi

    cd "$PKGDEST/upstream"
    # The upstream Remote Device Agent starts its local MCP server as a child
    # and connects outbound to the official Remote MCP service.
    nohup env HOME="$HOME_DIR" PATH="$PKGDEST/runtime:$PATH" DC_NODE_LAUNCHER="$NODE" DC_AUTH_STATUS_FILE="$PKGVAR/auth-state.json" \
        NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=$PKGDEST/runtime/exec-path-fix.cjs" \
        DC_REMOTE_DEVICE=true DESKTOP_COMMANDER_DISABLE_TELEMETRY=1 \
        "$NODE" "$APP" remote --disable-no-sleep >>"$LOG_FILE" 2>&1 </dev/null &
    echo "$!" > "$PID_FILE"
    chmod 600 "$PID_FILE" "$LOG_FILE" 2>/dev/null || true
}

stop() {
    if is_running; then
        pid="$(cat "$PID_FILE")"
        kill -TERM "$pid" 2>/dev/null || true
        n=0
        while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 20 ]; do
            sleep 1
            n=$((n + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$PID_FILE"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status)
        if is_running; then echo "running"; exit 0; fi
        echo "stopped"; exit 1
        ;;
    log) tail -n 200 "$LOG_FILE" 2>/dev/null || true ;;
    *) echo "Usage: $0 {start|stop|status|log}" >&2; exit 2 ;;
esac

